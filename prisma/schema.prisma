generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  LEARNER
  INSTRUCTOR
}

enum LessonKind {
  TEXT
  VIDEO
}

enum CurriculumChangeKind {
  CONCEPT_ADDED
  CONCEPT_UPDATED
  CONCEPT_ARCHIVED
  PREREQUISITE_ADDED
  PREREQUISITE_REMOVED
  CONCEPT_SPLIT
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  passwordHash      String?
  role              UserRole           @default(LEARNER)
  coursesCreated    Course[]           @relation("CourseInstructor")
  enrollments       Enrollment[]
  quizAttempts      QuizAttempt[]
  lessonProgress    LessonProgress[]
  notifications     Notification[]
  curriculumChanges CurriculumChange[] @relation("ChangeActor")
  learningPaths     LearningPath[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Course {
  id                 String             @id @default(cuid())
  title              String
  slug               String             @unique
  description        String
  instructorId       String
  curriculumRevision Int                @default(1)
  instructor         User               @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: Restrict)
  concepts           Concept[]
  enrollments        Enrollment[]
  curriculumChanges  CurriculumChange[]
  learningPaths      LearningPath[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([userId, courseId])
}

model Concept {
  id                    String                @id @default(cuid())
  courseId              String
  title                 String
  description           String
  order                 Int
  lessonDurationMinutes Int                   @default(0)
  archivedAt            DateTime?
  course                Course                @relation(fields: [courseId], references: [id], onDelete: Restrict)
  prerequisiteLinks     ConceptPrerequisite[] @relation("ConceptPrerequisites")
  dependentLinks        ConceptPrerequisite[] @relation("ConceptDependents")
  lessons               Lesson[]
  quizzes               Quiz[]
  lessonProgress        LessonProgress[]
  learningPathTargets   LearningPath[]        @relation("LearningPathTarget")
  curriculumChanges     CurriculumChange[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([courseId, order])
  @@index([courseId, archivedAt])
}

model ConceptPrerequisite {
  id                    String   @id @default(cuid())
  conceptId             String
  prerequisiteConceptId String
  concept               Concept  @relation("ConceptPrerequisites", fields: [conceptId], references: [id], onDelete: Restrict)
  prerequisite          Concept  @relation("ConceptDependents", fields: [prerequisiteConceptId], references: [id], onDelete: Restrict)
  createdAt             DateTime @default(now())

  @@unique([conceptId, prerequisiteConceptId])
  @@index([prerequisiteConceptId])
}

model Lesson {
  id              String           @id @default(cuid())
  conceptId       String
  title           String
  kind            LessonKind       @default(TEXT)
  content         String?
  videoUrl        String?
  durationMinutes Int
  archivedAt      DateTime?
  concept         Concept          @relation(fields: [conceptId], references: [id], onDelete: Restrict)
  progress        LessonProgress[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([conceptId, title])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  concept     Concept? @relation(fields: [conceptId], references: [id])
  conceptId   String?

  @@unique([userId, lessonId])
  @@index([userId, completedAt])
}

model Quiz {
  id               String        @id @default(cuid())
  conceptId        String
  title            String
  passingThreshold Int           @default(70)
  archivedAt       DateTime?
  concept          Concept       @relation(fields: [conceptId], references: [id], onDelete: Restrict)
  questions        Question[]
  attempts         QuizAttempt[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([conceptId, title])
}

model Question {
  id                 String    @id @default(cuid())
  quizId             String
  prompt             String
  options            String[]
  correctOptionIndex Int
  explanation        String
  position           Int
  archivedAt         DateTime?
  quiz               Quiz      @relation(fields: [quizId], references: [id], onDelete: Restrict)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([quizId, position])
}

model QuizAttempt {
  id               String   @id @default(cuid())
  userId           String
  quizId           String
  score            Int
  passed           Boolean
  answers          Json
  questionSnapshot Json
  attemptedAt      DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  quiz             Quiz     @relation(fields: [quizId], references: [id], onDelete: Restrict)

  @@index([userId, quizId, attemptedAt])
}

model CurriculumChange {
  id             String               @id @default(cuid())
  courseId       String
  actorId        String?
  conceptId      String?
  revision       Int
  kind           CurriculumChangeKind
  summary        String
  beforeSnapshot Json?
  afterSnapshot  Json?
  createdAt      DateTime             @default(now())
  course         Course               @relation(fields: [courseId], references: [id], onDelete: Restrict)
  actor          User?                @relation("ChangeActor", fields: [actorId], references: [id], onDelete: SetNull)
  concept        Concept?             @relation(fields: [conceptId], references: [id], onDelete: SetNull)

  @@unique([courseId, revision])
  @@index([courseId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, readAt, createdAt])
}

model LearningPath {
  id                 String   @id @default(cuid())
  userId             String
  courseId           String
  targetConceptId    String
  curriculumRevision Int
  conceptIds         Json
  estimatedMinutes   Int
  calculatedAt       DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  course             Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  targetConcept      Concept  @relation("LearningPathTarget", fields: [targetConceptId], references: [id], onDelete: Restrict)

  @@index([userId, courseId, calculatedAt])
}
